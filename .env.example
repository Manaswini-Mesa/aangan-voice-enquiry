# ─────────────────────────────────────────────────────────────────────────────
# Aangan Studio — AI voice enquiry system
# Copy to .env.local for local development:   cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables (never commit real values).
# Every variable is optional in DEMO mode. Values below are placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# demo = synthetic data, embedded database, nothing external is called
# live = real customers; requires DATABASE_URL and AUTH_SECRET at minimum
APP_MODE=demo

# Public URL of this app (used for dashboard links in emails), no trailing slash
APP_BASE_URL=http://localhost:3000

# ── Database (Neon PostgreSQL recommended) ───────────────────────────────────
# Neon → your project → Connection Details → "Pooled connection" string
DATABASE_URL=
# Demo-mode embedded database location (ignored when DATABASE_URL is set)
# DEMO_DATA_DIR=.data/pglite

# ── Dashboard sign-in ────────────────────────────────────────────────────────
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Live mode: creates the first admin automatically if no users exist (password 12+ chars).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Studio Admin
# Demo mode only. Demo accounts (all synthetic): admin@aangan.demo, manager@aangan.demo,
# designer.riya@aangan.demo, designer.kunal@aangan.demo. Default demo password: aangan-demo-2026
DEMO_PASSWORD=aangan-demo-2026
# DEMO_SEED=off   # uncomment to start demo mode with an empty database

# ── VaaniVoice (https://docs.vaanivoice.ai) ──────────────────────────────────
# Dashboard → Settings → API Keys
VAANI_API_KEY=
VAANI_AGENT_ID=
# VAANI_API_BASE_URL=https://api.vaanivoice.ai
# Random token you choose; webhook URL becomes  <APP_BASE_URL>/api/webhooks/vaani/<VAANI_WEBHOOK_TOKEN>
VAANI_WEBHOOK_TOKEN=
# Shared secret between the voice gateway and this app (same value in both places)
VOICE_GATEWAY_SECRET=
# Optional, for labelled cost ESTIMATES only (VaaniVoice publishes no billing API)
VAANI_INR_PER_MINUTE_ESTIMATE=

# Voice gateway only (runs separately — see docs/VAANIVOICE_SETUP.md)
# BYOL_AUTH_TOKEN=          # paste the same value in Vaani's BYOL "Auth Token" field
# PORT=8090

# ── AI model (Anthropic Claude) — optional; rules work without it ────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# on | off — per-turn LLM fact extraction (adds latency; rules remain authoritative)
AI_TURN_EXTRACTION=on
AI_TIMEOUT_MS=4000
# Optional: override list-price rates used for cost ESTIMATES (USD per million tokens)
# AI_INPUT_USD_PER_MTOK=
# AI_OUTPUT_USD_PER_MTOK=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Aangan Enquiries <enquiries@yourdomain.com>"
EMAIL_FROM=
# Comma-separated recipient lists
NOTIFY_HANDOFF_TO=
NOTIFY_REVIEW_TO=
NOTIFY_COMPLAINTS_TO=
NOTIFY_OPS_TO=
# EMAIL_USD_PER_EMAIL_ESTIMATE=
# SIMULATED_CALLS_SEND_EMAIL=false

# ── Business rules ───────────────────────────────────────────────────────────
# Commercial 500 sq ft minimum: PENDING_CONFIRMATION (default) | CONFIRMED | DISABLED
COMMERCIAL_MIN_STATUS=PENDING_CONFIRMATION
# INTERNAL ONLY budget review floors (never spoken, never sent to the AI), JSON, INR:
# BUDGET_REVIEW_FLOORS={"perRoomInr":0,"residentialPerSqftInr":0,"commercialPerSqftInr":0}

# ── Privacy & operations ─────────────────────────────────────────────────────
# Keep false unless recording is enabled in VaaniVoice AND callers are told.
CALL_RECORDING_ENABLED=false
TRANSCRIPT_RETENTION_DAYS=365
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/sweep
CRON_SECRET=
